<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
  Settings shared by everyone working on this project (committed to version control).
  Machine-specific paths live in MDK.paths.props, which the MDK extension generates.
  -->
  <PropertyGroup>
    <MDKVersion>1.4.14</MDKVersion>
    <MDKTrimTypes>
      <Enabled>no</Enabled>
    </MDKTrimTypes>
    <MDKMinify>
      <Level>full</Level>
    </MDKMinify>
    <MDKIgnore>
      <Folder>mdk\\</Folder>
    </MDKIgnore>
  </PropertyGroup>
</Project>
